rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isUsernameUid(uid) {
      return uid is string &&
             uid.size() >= 16 &&
             uid.size() <= 64 &&
             uid.matches('^usr_[a-zA-Z0-9_\\-]+$');
    }

    // Google accounts must strictly match Firebase Auth UID; pure username+password accounts use persistent usr_ UIDs.
    function isActorUid(uid) {
      return (isSignedIn() && request.auth.uid == uid) || isUsernameUid(uid);
    }

    function isAdmin() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email == 'ayazbugti100@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 40 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 128)) &&
             data.bio is string && data.bio.size() <= 200 &&
             data.dob is string && data.dob.size() >= 4 && data.dob.size() <= 20 &&
             data.provider in ['google', 'username'] &&
             (!('photoData' in data) || (data.photoData is string && data.photoData.size() <= 250000)) &&
             (!('bannerData' in data) || (data.bannerData is string && data.bannerData.size() <= 250000)) &&
             (!('profileVisibility' in data) || data.profileVisibility in ['everyone', 'selected', 'nobody']) &&
             (!('allowedViewerUids' in data) || (data.allowedViewerUids is list && data.allowedViewerUids.size() <= 500 && (data.allowedViewerUids.size() == 0 || data.allowedViewerUids[0] is string))) &&
             (!('maxProfileViewers' in data) || (data.maxProfileViewers is int && data.maxProfileViewers >= 0 && data.maxProfileViewers <= 500)) &&
             data.online is bool &&
             (!('showOnlineStatus' in data) || data.showOnlineStatus is bool) &&
             data.verified is bool &&
             data.premiumUnlocked is bool &&
             data.accountStatus in ['active', 'banned'] &&
             data.reportCount is int && data.reportCount >= 0 && data.reportCount <= 1000 &&
             (!('bannedByAdmin' in data) || data.bannedByAdmin is bool) &&
             (!('deletedContactIds' in data) || (data.deletedContactIds is list && data.deletedContactIds.size() <= 500)) &&
             (!('themeMode' in data) || (data.themeMode is string && data.themeMode.size() <= 20)) &&
             (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
             (!('smartAiEnabled' in data) || data.smartAiEnabled is bool) &&
             (!('appLockPinHash' in data) || (data.appLockPinHash is string && data.appLockPinHash.size() <= 128));
    }

    function isValidUsernameAccount(data) {
      return isUsernameUid(data.userId) &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 40 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.dob is string && data.dob.size() >= 4 && data.dob.size() <= 20 &&
             data.passwordSalt is string && data.passwordSalt.size() >= 16 && data.passwordSalt.size() <= 128 &&
             data.passwordHash is string && data.passwordHash.size() == 64 &&
             data.accountStatus in ['active', 'banned'] &&
             (!('bannedByAdmin' in data) || data.bannedByAdmin is bool);
    }

    function isValidDirectoryEntry(data) {
      return (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128)) &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 40 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             (!('provider' in data) || data.provider in ['google', 'username']) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
             (!('photoData' in data) || (data.photoData is string && data.photoData.size() <= 250000)) &&
             (!('bannerData' in data) || (data.bannerData is string && data.bannerData.size() <= 250000)) &&
             (!('profileVisibility' in data) || data.profileVisibility in ['everyone', 'selected', 'nobody']) &&
             (!('allowedViewerUids' in data) || (data.allowedViewerUids is list && data.allowedViewerUids.size() <= 500 && (data.allowedViewerUids.size() == 0 || data.allowedViewerUids[0] is string))) &&
             (!('maxProfileViewers' in data) || (data.maxProfileViewers is int && data.maxProfileViewers >= 0 && data.maxProfileViewers <= 500)) &&
             (!('online' in data) || data.online is bool) &&
             (!('showOnlineStatus' in data) || data.showOnlineStatus is bool) &&
             (!('verified' in data) || data.verified is bool) &&
             (!('bannedByAdmin' in data) || data.bannedByAdmin is bool) &&
             data.accountStatus in ['active', 'banned'] &&
             data.reportCount is int && data.reportCount >= 0 && data.reportCount <= 50 &&
             data.reportedByUids is list && data.reportedByUids.size() <= 50 &&
             (data.reportedByUids.size() == 0 || data.reportedByUids[0] is string) &&
             data.reportCount == data.reportedByUids.size() &&
             (
               (data.get('bannedByAdmin', false) == true && data.accountStatus == 'banned') ||
               (data.get('bannedByAdmin', false) == false &&
                ((data.reportCount >= 10 && data.accountStatus == 'banned') ||
                 (data.reportCount < 10 && data.accountStatus == 'active')))
             );
    }

    function isValidPublicProfile(data) {
      return data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 40 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             (!('provider' in data) || data.provider in ['google', 'username']) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
             (!('photoData' in data) || (data.photoData is string && data.photoData.size() <= 250000)) &&
             (!('bannerData' in data) || (data.bannerData is string && data.bannerData.size() <= 250000)) &&
             (!('profileVisibility' in data) || data.profileVisibility in ['everyone', 'selected', 'nobody']) &&
             (!('allowedViewerUids' in data) || (data.allowedViewerUids is list && data.allowedViewerUids.size() <= 500 && (data.allowedViewerUids.size() == 0 || data.allowedViewerUids[0] is string))) &&
             (!('maxProfileViewers' in data) || (data.maxProfileViewers is int && data.maxProfileViewers >= 0 && data.maxProfileViewers <= 500)) &&
             (!('online' in data) || data.online is bool) &&
             (!('showOnlineStatus' in data) || data.showOnlineStatus is bool) &&
             (!('verified' in data) || data.verified is bool) &&
             (!('bannedByAdmin' in data) || data.bannedByAdmin is bool) &&
             data.accountStatus in ['active', 'banned'];
    }

    function isValidContact(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 40 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.threadType in ['chat', 'group'] &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
             (!('photoData' in data) || (data.photoData is string && data.photoData.size() <= 250000)) &&
             (!('bannerData' in data) || (data.bannerData is string && data.bannerData.size() <= 250000)) &&
             data.online is bool &&
             data.typing is bool &&
             data.unreadCount is int && data.unreadCount >= 0 && data.unreadCount <= 99999 &&
             data.lastMessageText is string && data.lastMessageText.size() <= 1000 &&
             data.lastMessageFromMe is bool &&
             data.lastMessageTimeLabel is string && data.lastMessageTimeLabel.size() <= 30 &&
             (!('lastMessageReceiptStatus' in data) || data.lastMessageReceiptStatus in ['sent', 'delivered', 'read']) &&
             (!('lastMessageId' in data) || (data.lastMessageId is string && data.lastMessageId.size() <= 128)) &&
             data.pinned is bool &&
             (!('locked' in data) || data.locked is bool) &&
             (!('blocked' in data) || data.blocked is bool) &&
             (!('archived' in data) || data.archived is bool) &&
             (!('muted' in data) || data.muted is bool) &&
             (!('disappearingSeconds' in data) || (data.disappearingSeconds is int && data.disappearingSeconds >= 0 && data.disappearingSeconds <= 7776000)) &&
             (!('chatTheme' in data) || (data.chatTheme is string && data.chatTheme.size() >= 1 && data.chatTheme.size() <= 40)) &&
             (!('customRenamed' in data) || data.customRenamed is bool) &&
             (!('peerUid' in data) || (data.peerUid is string && data.peerUid.size() <= 128)) &&
             (!('isRegisteredPeer' in data) || data.isRegisteredPeer is bool) &&
             data.accountStatus in ['active', 'banned'] &&
             data.reportCount is int && data.reportCount >= 0 && data.reportCount <= 50 &&
             data.reportedBy is list && data.reportedBy.size() <= 50 &&
             (data.reportedBy.size() == 0 || data.reportedBy[0] is string) &&
             data.reportCount == data.reportedBy.size() &&
             (data.reportCount < 10 || data.accountStatus == 'banned');
    }

    function isValidMessage(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.contactId is string && isValidId(data.contactId) &&
             data.sender in ['me', 'them'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             (!('messageType' in data) || data.messageType in ['text', 'voice', 'image', 'file', 'call']) &&
             (!('mediaData' in data) || (data.mediaData is string && data.mediaData.size() <= 240000)) &&
             (!('durationSec' in data) || (data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 600)) &&
             (!('expiresAtMs' in data) || (data.expiresAtMs is int && data.expiresAtMs >= 0)) &&
             (!('replyToText' in data) || (data.replyToText is string && data.replyToText.size() <= 200)) &&
             (!('replyToSender' in data) || (data.replyToSender is string && data.replyToSender.size() <= 60)) &&
             (!('replyToMessageId' in data) || (data.replyToMessageId is string && data.replyToMessageId.size() <= 128)) &&
             (!('receiptStatus' in data) || data.receiptStatus in ['sent', 'delivered', 'read']) &&
             (!('senderMessageId' in data) || (data.senderMessageId is string && data.senderMessageId.size() <= 128)) &&
             (!('senderContactId' in data) || (data.senderContactId is string && data.senderContactId.size() <= 128)) &&
             data.timeLabel is string && data.timeLabel.size() >= 1 && data.timeLabel.size() <= 30 &&
             data.aiGenerated is bool;
    }

    function isValidStory(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.authorUsername is string && data.authorUsername.size() >= 1 && data.authorUsername.size() <= 40 &&
             (!('authorPhotoData' in data) || (data.authorPhotoData is string && data.authorPhotoData.size() <= 250000)) &&
             data.mediaData is string && data.mediaData.size() >= 1 && data.mediaData.size() <= 920000 &&
             (!('mediaType' in data) || data.mediaType in ['image', 'video', 'text']) &&
             data.caption is string && data.caption.size() <= 140 &&
             (!('storyFont' in data) || (data.storyFont is string && data.storyFont.size() >= 1 && data.storyFont.size() <= 40)) &&
             (!('musicTag' in data) || (data.musicTag is string && data.musicTag.size() <= 80)) &&
             (!('overlayText' in data) || (data.overlayText is string && data.overlayText.size() <= 140)) &&
             (!('overlayColorHex' in data) || data.overlayColorHex is int) &&
             (!('overlayYFraction' in data) || (data.overlayYFraction is number && data.overlayYFraction >= 0.0 && data.overlayYFraction <= 1.0)) &&
             (!('stickersJson' in data) || (data.stickersJson is string && data.stickersJson.size() <= 4000)) &&
             (!('drawingJson' in data) || (data.drawingJson is string && data.drawingJson.size() <= 24000)) &&
             (!('cropMode' in data) || data.cropMode in ['crop', 'fit']) &&
             (!('rotationDegrees' in data) || data.rotationDegrees in [0, 90, 180, 270]) &&
             (!('viewedByUids' in data) || (data.viewedByUids is list && data.viewedByUids.size() <= 500 && (data.viewedByUids.size() == 0 || data.viewedByUids[0] is string))) &&
             (!('likedByUids' in data) || (data.likedByUids is list && data.likedByUids.size() <= 500 && (data.likedByUids.size() == 0 || data.likedByUids[0] is string))) &&
             data.createdAtMs is int && data.createdAtMs > 0 &&
             data.expiresAtMs is int && data.expiresAtMs > data.createdAtMs &&
             (data.expiresAtMs - data.createdAtMs) <= 86400000;
    }

    function isValidStoryView(data) {
      return data.viewerUid is string && data.viewerUid.size() >= 1 && data.viewerUid.size() <= 128 &&
             data.viewerName is string && data.viewerName.size() >= 1 && data.viewerName.size() <= 60 &&
             data.viewerUsername is string && data.viewerUsername.size() >= 1 && data.viewerUsername.size() <= 40 &&
             (!('viewerPhotoData' in data) || (data.viewerPhotoData is string && data.viewerPhotoData.size() <= 250000)) &&
             data.liked is bool &&
             data.reactionEmoji is string && data.reactionEmoji.size() <= 16 &&
             data.viewedAtMs is int && data.viewedAtMs > 0;
    }

    function isValidCredentialRecord(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 40 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.dob is string && data.dob.size() >= 4 && data.dob.size() <= 20 &&
             data.passwordSalt is string && data.passwordSalt.size() >= 16 && data.passwordSalt.size() <= 128 &&
             data.passwordHash is string && data.passwordHash.size() == 64 &&
             data.accountStatus in ['active', 'banned'];
    }

    match /username_accounts/{username} {
      allow get: if isValidId(username);
      allow list: if isAdmin();

      allow create: if isValidId(username) &&
                       incoming().username == username &&
                       isUsernameUid(incoming().userId) &&
                       incoming().accountStatus == 'active' &&
                       (!('bannedByAdmin' in incoming()) || incoming().bannedByAdmin == false) &&
                       incoming().keys().hasAll([
                         'userId', 'username', 'displayName', 'dob',
                         'passwordSalt', 'passwordHash', 'accountStatus',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'username', 'displayName', 'dob',
                         'passwordSalt', 'passwordHash', 'accountStatus', 'bannedByAdmin',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUsernameAccount(incoming()) &&
                       getAfter(/databases/$(database)/documents/users/$(incoming().userId)).data.username == username;

      allow update: if isValidId(username) &&
                       isValidUsernameAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().username == existing().username &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'accountStatus', 'bannedByAdmin', 'updatedAt'
                          ])) ||
                         (incoming().accountStatus == existing().accountStatus &&
                          incoming().get('bannedByAdmin', false) == existing().get('bannedByAdmin', false) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'displayName', 'dob', 'passwordSalt', 'passwordHash', 'updatedAt'
                          ]))
                       );

      allow delete: if isValidId(username) &&
                       (
                         isAdmin() ||
                         (getAfter(/databases/$(database)/documents/users/$(existing().userId)).data.username != username)
                       );
    }

    match /users/{userId} {
      allow get: if isValidId(userId) &&
                    (
                      isAdmin() ||
                      (isSignedIn() && request.auth.uid == userId) ||
                      (isUsernameUid(userId) && (resource == null || existing().provider == 'username'))
                    );
      allow list: if isAdmin();

      allow create: if isValidId(userId) &&
                       isActorUid(userId) &&
                       incoming().userId == userId &&
                       incoming().accountStatus == 'active' &&
                       incoming().reportCount == 0 &&
                       incoming().verified == isAdmin() &&
                       (isUsernameUid(userId) ? (incoming().provider == 'username' && incoming().verified == false) : true) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'username', 'bio', 'dob', 'provider',
                         'online', 'verified', 'premiumUnlocked',
                         'accountStatus', 'reportCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'username', 'email', 'bio', 'dob', 'provider', 'photoData', 'bannerData',
                         'profileVisibility', 'allowedViewerUids', 'maxProfileViewers',
                         'online', 'showOnlineStatus', 'verified', 'premiumUnlocked',
                         'accountStatus', 'reportCount',
                         'themeMode', 'notificationsEnabled', 'smartAiEnabled', 'appLockPinHash',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().provider == existing().provider &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (isActorUid(userId) &&
                          (isUsernameUid(userId) ? existing().provider == 'username' : true) &&
                          incoming().accountStatus == existing().accountStatus &&
                          incoming().reportCount == existing().reportCount &&
                          incoming().get('bannedByAdmin', false) == existing().get('bannedByAdmin', false) &&
                          (incoming().get('verified', false) == existing().get('verified', false) || (isAdmin() && incoming().get('verified', false) == true)) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'displayName', 'username', 'email', 'bio', 'dob', 'photoData', 'bannerData',
                            'profileVisibility', 'allowedViewerUids', 'maxProfileViewers',
                            'online', 'showOnlineStatus', 'verified', 'premiumUnlocked', 'deletedContactIds',
                            'themeMode', 'notificationsEnabled', 'smartAiEnabled', 'appLockPinHash',
                            'updatedAt'
                          ])) ||
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'accountStatus', 'reportCount', 'bannedByAdmin', 'verified', 'updatedAt'
                          ]))
                       );

      allow delete: if isValidId(userId) &&
                       isActorUid(userId) &&
                       (isSignedIn() || existing().provider == 'username');

      match /contacts/{contactId} {
        allow get: if isValidId(userId) && isValidId(contactId) && isActorUid(userId);
        allow list: if isValidId(userId) && isActorUid(userId);

        allow create: if isValidId(userId) &&
                         isValidId(contactId) &&
                         isActorUid(userId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'username', 'phone', 'threadType',
                           'online', 'typing', 'unreadCount', 'lastMessageText',
                           'lastMessageFromMe', 'lastMessageTimeLabel', 'pinned',
                           'accountStatus', 'reportCount', 'reportedBy',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'username', 'phone', 'threadType', 'bio', 'photoData', 'bannerData',
                           'online', 'typing', 'unreadCount', 'lastMessageText',
                           'lastMessageFromMe', 'lastMessageTimeLabel',
                           'lastMessageReceiptStatus', 'lastMessageId', 'pinned',
                           'locked', 'blocked', 'archived', 'muted', 'disappearingSeconds', 'chatTheme',
                           'customRenamed', 'peerUid', 'isRegisteredPeer',
                           'accountStatus', 'reportCount', 'reportedBy',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidContact(incoming());

        allow update: if isValidId(userId) &&
                         isValidId(contactId) &&
                         isActorUid(userId) &&
                         isValidContact(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'username', 'phone', 'threadType', 'bio', 'photoData', 'bannerData', 'online', 'typing',
                           'unreadCount', 'lastMessageText', 'lastMessageFromMe',
                           'lastMessageTimeLabel', 'lastMessageReceiptStatus', 'lastMessageId',
                           'pinned', 'locked', 'blocked', 'archived',
                           'muted', 'disappearingSeconds', 'chatTheme',
                           'customRenamed', 'peerUid', 'isRegisteredPeer',
                           'accountStatus', 'reportCount', 'reportedBy', 'updatedAt'
                         ]);

        allow delete: if isValidId(userId) && isValidId(contactId) && isActorUid(userId);

        match /messages/{messageId} {
          allow get: if isValidId(userId) &&
                        isValidId(contactId) &&
                        isValidId(messageId) &&
                        isActorUid(userId);
          allow list: if isValidId(userId) && isActorUid(userId);

          allow create: if isValidId(userId) &&
                           isValidId(contactId) &&
                           isValidId(messageId) &&
                           isActorUid(userId) &&
                           incoming().userId == userId &&
                           incoming().contactId == contactId &&
                           incoming().keys().hasAll([
                             'userId', 'contactId', 'sender', 'text',
                             'timeLabel', 'aiGenerated', 'createdAt'
                           ]) &&
                           incoming().keys().hasOnly([
                             'userId', 'contactId', 'sender', 'text',
                             'messageType', 'mediaData', 'durationSec', 'expiresAtMs',
                             'replyToText', 'replyToSender', 'replyToMessageId',
                             'receiptStatus', 'senderMessageId', 'senderContactId',
                             'timeLabel', 'aiGenerated', 'createdAt'
                           ]) &&
                           incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                           isValidMessage(incoming()) &&
                           existsAfter(/databases/$(database)/documents/users/$(userId)/contacts/$(contactId));

          allow update: if isValidId(userId) &&
                           isValidId(contactId) &&
                           isValidId(messageId) &&
                           isActorUid(userId) &&
                           isValidMessage(incoming()) &&
                           incoming().userId == existing().userId &&
                           incoming().contactId == existing().contactId &&
                           incoming().sender == existing().sender &&
                           incoming().text == existing().text &&
                           incoming().timeLabel == existing().timeLabel &&
                           incoming().aiGenerated == existing().aiGenerated &&
                           incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['receiptStatus']) &&
                           (
                             existing().get('receiptStatus', 'sent') == 'sent' ||
                             (existing().get('receiptStatus', 'sent') == 'delivered' && incoming().receiptStatus in ['delivered', 'read']) ||
                             (existing().get('receiptStatus', 'sent') == 'read' && incoming().receiptStatus == 'read')
                           );

          allow delete: if isValidId(userId) &&
                           isValidId(contactId) &&
                           isValidId(messageId) &&
                           isActorUid(userId);
        }
      }

      match /credentials/{username} {
        allow get: if isValidId(userId) && isValidId(username) && isActorUid(userId);
        allow list: if false;

        allow create: if isValidId(userId) &&
                         isValidId(username) &&
                         isActorUid(userId) &&
                         incoming().userId == userId &&
                         incoming().username == username &&
                         incoming().accountStatus == 'active' &&
                         incoming().keys().hasAll([
                           'userId', 'username', 'displayName', 'dob',
                           'passwordSalt', 'passwordHash', 'accountStatus',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'username', 'displayName', 'dob',
                           'passwordSalt', 'passwordHash', 'accountStatus',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidCredentialRecord(incoming());

        allow update: if isValidId(userId) &&
                         isValidId(username) &&
                         isActorUid(userId) &&
                         isValidCredentialRecord(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().username == existing().username &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'dob', 'passwordSalt', 'passwordHash', 'accountStatus', 'updatedAt'
                         ]);

        allow delete: if isValidId(userId) && isValidId(username) && isActorUid(userId);
      }
    }

    match /usernames/{username} {
      allow get: if isValidId(username);
      allow list: if false;

      allow create: if isValidId(username) &&
                       incoming().username is string &&
                       incoming().username.size() >= 2 &&
                       incoming().username.size() <= 40 &&
                       incoming().username == username &&
                       isActorUid(incoming().ownerUid) &&
                       incoming().status == 'active' &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().keys().hasAll([
                         'username', 'ownerUid', 'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'username', 'ownerUid', 'status', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isValidId(username) &&
                       incoming().username == existing().username &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'ownerUid', 'updatedAt'
                       ]) &&
                       (
                         (existing().status == 'active' &&
                          isActorUid(existing().ownerUid) &&
                          incoming().status == 'retired' &&
                          incoming().ownerUid == '') ||
                         (existing().status == 'retired' &&
                          existing().ownerUid == '' &&
                          incoming().status == 'active' &&
                          isActorUid(incoming().ownerUid))
                       );

      allow delete: if false;
    }

    match /directory/{username} {
      allow get: if isValidId(username);
      allow list: if isAdmin() || (request.query.limit != null && request.query.limit <= 30);

      allow create: if isValidId(username) &&
                       incoming().username == username &&
                       incoming().keys().hasAll([
                         'username', 'displayName', 'accountStatus',
                         'reportCount', 'reportedByUids', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerUid', 'username', 'displayName', 'provider', 'bio', 'photoData', 'bannerData',
                         'profileVisibility', 'allowedViewerUids', 'maxProfileViewers', 'online', 'showOnlineStatus',
                         'verified', 'accountStatus', 'reportCount', 'reportedByUids', 'bannedByAdmin', 'createdAt', 'updatedAt'
                       ]) &&
                       (!('bannedByAdmin' in incoming()) || incoming().bannedByAdmin == false) &&
                       (!('verified' in incoming()) || incoming().verified == isAdmin()) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidDirectoryEntry(incoming()) &&
                       (
                         (incoming().reportCount == 0 && isActorUid(incoming().ownerUid)) ||
                         (incoming().reportCount == 1 &&
                          incoming().reportedByUids.size() == 1 &&
                          isActorUid(incoming().reportedByUids[0]))
                       );

      allow update: if isValidId(username) &&
                       isValidDirectoryEntry(incoming()) &&
                       incoming().username == existing().username &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         // Owner updating display name, bio, photo, banner, privacy rules, or presence without altering moderation state
                         ('ownerUid' in existing() &&
                          isActorUid(existing().ownerUid) &&
                          (incoming().get('verified', false) == existing().get('verified', false) || (isAdmin() && incoming().get('verified', false) == true)) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'displayName', 'bio', 'photoData', 'bannerData',
                            'profileVisibility', 'allowedViewerUids', 'maxProfileViewers',
                            'online', 'showOnlineStatus', 'verified', 'updatedAt'
                          ])) ||
                         // Reporter appending their own unique UID once
                         (incoming().reportedByUids.hasAll(existing().reportedByUids) &&
                          incoming().reportedByUids.size() == existing().reportedByUids.size() + 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'reportedByUids', 'reportCount', 'accountStatus', 'updatedAt'
                          ]) &&
                          (
                            (isSignedIn() &&
                             !(request.auth.uid in existing().reportedByUids) &&
                             request.auth.uid in incoming().reportedByUids) ||
                            (!isSignedIn() &&
                             isUsernameUid(incoming().reportedByUids[existing().reportedByUids.size()]) &&
                             !(incoming().reportedByUids[existing().reportedByUids.size()] in existing().reportedByUids))
                          )) ||
                         // Verified admin directly banning or recovering accounts
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'accountStatus', 'reportCount', 'reportedByUids', 'bannedByAdmin', 'verified', 'updatedAt'
                          ]))
                       );

      allow delete: if isValidId(username) &&
                       ('ownerUid' in existing()) &&
                       isActorUid(existing().ownerUid);
    }

    match /public_profiles/{userId} {
      allow get: if isValidId(userId);
      allow list: if request.query.limit != null && request.query.limit <= 30;

      allow create: if isValidId(userId) &&
                       isActorUid(userId) &&
                       incoming().ownerUid == userId &&
                       incoming().accountStatus == 'active' &&
                       (!('bannedByAdmin' in incoming()) || incoming().bannedByAdmin == false) &&
                       (!('verified' in incoming()) || incoming().verified == isAdmin()) &&
                       incoming().keys().hasAll([
                         'ownerUid', 'username', 'displayName', 'accountStatus', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerUid', 'username', 'displayName', 'provider', 'bio', 'photoData', 'bannerData',
                         'profileVisibility', 'allowedViewerUids', 'maxProfileViewers',
                         'online', 'showOnlineStatus', 'verified', 'accountStatus', 'bannedByAdmin', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidPublicProfile(incoming());

      allow update: if isValidId(userId) &&
                       isValidPublicProfile(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (isActorUid(userId) &&
                          incoming().accountStatus == existing().accountStatus &&
                          incoming().get('bannedByAdmin', false) == existing().get('bannedByAdmin', false) &&
                          (incoming().get('verified', false) == existing().get('verified', false) || (isAdmin() && incoming().get('verified', false) == true)) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'username', 'displayName', 'provider', 'bio', 'photoData', 'bannerData',
                            'profileVisibility', 'allowedViewerUids', 'maxProfileViewers',
                            'online', 'showOnlineStatus', 'verified', 'updatedAt'
                          ])) ||
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'accountStatus', 'bannedByAdmin', 'verified', 'updatedAt'
                          ]))
                       );

      allow delete: if isValidId(userId) && isActorUid(userId);
    }

    match /admin_config/{configId} {
      allow get, list: if isAdmin();

      allow create, update: if isAdmin() &&
                               isValidId(configId) &&
                               incoming().lockedGmail == 'ayazbugti100@gmail.com' &&
                               incoming().adminUid == request.auth.uid &&
                               incoming().enabled is bool &&
                               incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                               incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                               incoming().keys().hasAll([
                                 'lockedGmail', 'adminUid', 'enabled', 'createdAt', 'updatedAt'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'lockedGmail', 'adminUid', 'enabled', 'createdAt', 'updatedAt'
                               ]);

      allow delete: if false;
    }

    match /moderation_alerts/{alertId} {
      allow get, list: if isAdmin();

      allow create: if isValidId(alertId) &&
                       isActorUid(incoming().reporterUid) &&
                       incoming().status == 'pending' &&
                       (!('alertType' in incoming()) || incoming().alertType in ['report', 'appeal']) &&
                       incoming().reportedUid is string && incoming().reportedUid.size() <= 128 &&
                       incoming().reportedUsername is string && incoming().reportedUsername.size() >= 1 && incoming().reportedUsername.size() <= 40 &&
                       incoming().reportedDisplayName is string && incoming().reportedDisplayName.size() >= 1 && incoming().reportedDisplayName.size() <= 60 &&
                       incoming().reporterUsername is string && incoming().reporterUsername.size() >= 1 && incoming().reporterUsername.size() <= 40 &&
                       (!('reporterEmail' in incoming()) || (incoming().reporterEmail is string && incoming().reporterEmail.size() <= 128)) &&
                       incoming().reason is string && incoming().reason.size() >= 1 && incoming().reason.size() <= 100 &&
                       (!('appealMessage' in incoming()) || (incoming().appealMessage is string && incoming().appealMessage.size() <= 600)) &&
                       (!('aiRecommendation' in incoming()) || incoming().aiRecommendation in ['', 'RESTORE', 'KEEP_BANNED']) &&
                       (!('aiRiskLevel' in incoming()) || incoming().aiRiskLevel in ['', 'LOW', 'MEDIUM', 'HIGH']) &&
                       (!('aiAnalysis' in incoming()) || (incoming().aiAnalysis is string && incoming().aiAnalysis.size() <= 400)) &&
                       (!('aiPrompt' in incoming()) || (incoming().aiPrompt is string && incoming().aiPrompt.size() <= 300)) &&
                       incoming().createdAtMs is int && incoming().createdAtMs > 0 &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().keys().hasAll([
                         'reportedUid', 'reportedUsername', 'reportedDisplayName',
                         'reporterUid', 'reporterUsername', 'reason', 'status',
                         'createdAtMs', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'alertType', 'reportedUid', 'reportedUsername', 'reportedDisplayName',
                         'reporterUid', 'reporterUsername', 'reporterEmail',
                         'reason', 'appealMessage', 'aiRecommendation', 'aiRiskLevel',
                         'aiAnalysis', 'aiPrompt', 'status', 'adminEmail', 'createdAtMs', 'resolvedAtMs',
                         'createdAt', 'updatedAt'
                       ]);

      allow update: if isAdmin() &&
                       isValidId(alertId) &&
                       incoming().status in ['pending', 'ignored', 'banned', 'recovered'] &&
                       incoming().reporterUid == existing().reporterUid &&
                       incoming().reportedUsername == existing().reportedUsername &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (!('resolvedAtMs' in incoming()) || (incoming().resolvedAtMs is int && incoming().resolvedAtMs >= 0)) &&
                       (!('adminEmail' in incoming()) || incoming().adminEmail == 'ayazbugti100@gmail.com') &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'adminEmail', 'resolvedAtMs', 'updatedAt'
                       ]);

      allow delete: if isAdmin() && isValidId(alertId);
    }

    match /stories/{storyId} {
      allow get: if isValidId(storyId);
      allow list: if isSignedIn() || (request.query.limit != null && request.query.limit <= 100);

      allow create: if isValidId(storyId) &&
                       isActorUid(incoming().userId) &&
                       incoming().keys().hasAll([
                         'userId', 'authorName', 'authorUsername', 'mediaData',
                         'caption', 'createdAtMs', 'expiresAtMs', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'authorName', 'authorUsername', 'authorPhotoData',
                         'mediaData', 'mediaType', 'caption', 'storyFont',
                         'musicTag', 'overlayText', 'overlayColorHex', 'overlayYFraction',
                         'stickersJson', 'drawingJson', 'cropMode', 'rotationDegrees',
                         'viewedByUids', 'likedByUids', 'createdAtMs', 'expiresAtMs', 'createdAt'
                       ]) &&
                       (!('viewedByUids' in incoming()) || incoming().viewedByUids.size() == 0) &&
                       (!('likedByUids' in incoming()) || incoming().likedByUids.size() == 0) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidStory(incoming());

      allow update: if isValidId(storyId) &&
                       isValidStory(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['viewedByUids', 'likedByUids']) &&
                       (
                         (isSignedIn() &&
                          (
                            incoming().get('viewedByUids', []) == existing().get('viewedByUids', []) ||
                            (
                              (request.auth.uid in incoming().get('viewedByUids', [])) &&
                              incoming().get('viewedByUids', []).hasAll(existing().get('viewedByUids', [])) &&
                              incoming().get('viewedByUids', []).size() <= existing().get('viewedByUids', []).size() + 1
                            )
                          ) &&
                          (
                            incoming().get('likedByUids', []) == existing().get('likedByUids', []) ||
                            (
                              !(request.auth.uid in existing().get('likedByUids', [])) &&
                              (request.auth.uid in incoming().get('likedByUids', [])) &&
                              incoming().get('likedByUids', []).hasAll(existing().get('likedByUids', [])) &&
                              incoming().get('likedByUids', []).size() == existing().get('likedByUids', []).size() + 1
                            ) ||
                            (
                              (request.auth.uid in existing().get('likedByUids', [])) &&
                              !(request.auth.uid in incoming().get('likedByUids', [])) &&
                              existing().get('likedByUids', []).hasAll(incoming().get('likedByUids', [])) &&
                              existing().get('likedByUids', []).size() == incoming().get('likedByUids', []).size() + 1
                            )
                          )) ||
                         (!isSignedIn() &&
                          (
                            incoming().get('viewedByUids', []) == existing().get('viewedByUids', []) ||
                            (
                              incoming().get('viewedByUids', []).hasAll(existing().get('viewedByUids', [])) &&
                              incoming().get('viewedByUids', []).size() == existing().get('viewedByUids', []).size() + 1 &&
                              isUsernameUid(incoming().get('viewedByUids', [])[existing().get('viewedByUids', []).size()]) &&
                              !(incoming().get('viewedByUids', [])[existing().get('viewedByUids', []).size()] in existing().get('viewedByUids', []))
                            )
                          ) &&
                          (
                            incoming().get('likedByUids', []) == existing().get('likedByUids', []) ||
                            (
                              incoming().get('likedByUids', []).hasAll(existing().get('likedByUids', [])) &&
                              incoming().get('likedByUids', []).size() == existing().get('likedByUids', []).size() + 1 &&
                              isUsernameUid(incoming().get('likedByUids', [])[existing().get('likedByUids', []).size()]) &&
                              !(incoming().get('likedByUids', [])[existing().get('likedByUids', []).size()] in existing().get('likedByUids', []))
                            ) ||
                            (
                              existing().get('likedByUids', []).hasAll(incoming().get('likedByUids', [])) &&
                              existing().get('likedByUids', []).size() == incoming().get('likedByUids', []).size() + 1
                            )
                          ))
                       );

      allow delete: if isValidId(storyId) && isActorUid(existing().userId);

      match /views/{viewerId} {
        allow get: if isValidId(storyId) && isValidId(viewerId) &&
                      (isActorUid(viewerId) ||
                       isActorUid(get(/databases/$(database)/documents/stories/$(storyId)).data.userId));

        allow list: if isValidId(storyId) &&
                       isActorUid(get(/databases/$(database)/documents/stories/$(storyId)).data.userId);

        allow create, update: if isValidId(storyId) &&
                                 isValidId(viewerId) &&
                                 isActorUid(viewerId) &&
                                 incoming().viewerUid == viewerId &&
                                 incoming().keys().hasAll([
                                   'viewerUid', 'viewerName', 'viewerUsername',
                                   'liked', 'reactionEmoji', 'viewedAtMs', 'updatedAt'
                                 ]) &&
                                 incoming().keys().hasOnly([
                                   'viewerUid', 'viewerName', 'viewerUsername', 'viewerPhotoData',
                                   'liked', 'reactionEmoji', 'viewedAtMs', 'updatedAt'
                                 ]) &&
                                 incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                                 isValidStoryView(incoming());

        allow delete: if isValidId(storyId) && isValidId(viewerId) &&
                         (isActorUid(viewerId) ||
                          isActorUid(get(/databases/$(database)/documents/stories/$(storyId)).data.userId));
      }
    }

    match /direct_messages/{messageId} {
      allow get: if isValidId(messageId) &&
                    (isActorUid(existing().fromUid) || isActorUid(existing().toUid));
      allow list: if (isSignedIn() && resource.data.toUid == request.auth.uid) ||
                     (!isSignedIn() && isUsernameUid(resource.data.toUid));

      allow create: if isValidId(messageId) &&
                       isActorUid(incoming().fromUid) &&
                       incoming().toUid is string && incoming().toUid.size() >= 1 && incoming().toUid.size() <= 128 &&
                       incoming().fromUsername is string && incoming().fromUsername.size() >= 1 && incoming().fromUsername.size() <= 40 &&
                       incoming().fromDisplayName is string && incoming().fromDisplayName.size() >= 1 && incoming().fromDisplayName.size() <= 60 &&
                       incoming().toUsername is string && incoming().toUsername.size() >= 1 && incoming().toUsername.size() <= 40 &&
                       incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 2000 &&
                       (!('messageType' in incoming()) || incoming().messageType in ['text', 'voice', 'image', 'file', 'call']) &&
                       (!('mediaData' in incoming()) || (incoming().mediaData is string && incoming().mediaData.size() <= 240000)) &&
                       (!('durationSec' in incoming()) || (incoming().durationSec is int && incoming().durationSec >= 0 && incoming().durationSec <= 600)) &&
                       (!('replyToText' in incoming()) || (incoming().replyToText is string && incoming().replyToText.size() <= 200)) &&
                       (!('replyToSender' in incoming()) || (incoming().replyToSender is string && incoming().replyToSender.size() <= 60)) &&
                       (!('replyToMessageId' in incoming()) || (incoming().replyToMessageId is string && incoming().replyToMessageId.size() <= 128)) &&
                       (!('senderMessageId' in incoming()) || (incoming().senderMessageId is string && incoming().senderMessageId.size() <= 128)) &&
                       (!('senderContactId' in incoming()) || (incoming().senderContactId is string && incoming().senderContactId.size() <= 128)) &&
                       incoming().timeLabel is string && incoming().timeLabel.size() >= 1 && incoming().timeLabel.size() <= 30 &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().keys().hasAll([
                         'fromUid', 'toUid', 'fromUsername', 'fromDisplayName',
                         'toUsername', 'text', 'timeLabel', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'fromUid', 'toUid', 'fromUsername', 'fromDisplayName',
                         'toUsername', 'text', 'messageType', 'mediaData', 'durationSec',
                         'replyToText', 'replyToSender', 'replyToMessageId',
                         'senderMessageId', 'senderContactId',
                         'timeLabel', 'createdAt'
                       ]);

      allow update: if false;

      allow delete: if isValidId(messageId) && isActorUid(existing().toUid);
    }

    match /message_receipts/{receiptId} {
      allow get: if isValidId(receiptId) &&
                    (isActorUid(existing().fromUid) || isActorUid(existing().toUid));
      allow list: if (isSignedIn() && resource.data.toUid == request.auth.uid) ||
                     (!isSignedIn() && isUsernameUid(resource.data.toUid));

      allow create: if isValidId(receiptId) &&
                       isActorUid(incoming().fromUid) &&
                       incoming().toUid is string && incoming().toUid.size() >= 1 && incoming().toUid.size() <= 128 &&
                       incoming().senderContactId is string && isValidId(incoming().senderContactId) &&
                       incoming().senderMessageId is string && isValidId(incoming().senderMessageId) &&
                       incoming().status in ['delivered', 'read'] &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().keys().hasAll([
                         'fromUid', 'toUid', 'senderContactId', 'senderMessageId', 'status', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'fromUid', 'toUid', 'senderContactId', 'senderMessageId', 'status', 'createdAt'
                       ]);

      allow update: if false;

      allow delete: if isValidId(receiptId) && isActorUid(existing().toUid);
    }
  }
}
